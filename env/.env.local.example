# =====================================================================
# PizzaFlow - ambiente LOCAL
# Copie para env/.env.local (ignorado pelo Git) e preencha.
# Banco local via 'docker compose up -d'. Para testar webhooks use um túnel (ngrok/cloudflared) em MercadoPago__NotificationUrl.
# Variaveis ja definidas no ambiente do servidor tem prioridade sobre este arquivo.
# =====================================================================
APP_ENV=local
ASPNETCORE_URLS=http://localhost:5080

# --- Banco (NeonDB: Connect > converta para o formato Npgsql; remova channel_binding) ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=pizzaflow;Username=postgres;Password=postgres

# --- JWT (minimo 32 caracteres; gere com: openssl rand -base64 48) ---
Jwt__Secret=TROQUE-POR-UMA-CHAVE-ALEATORIA-COM-NO-MINIMO-32-CARACTERES
Jwt__ExpiresMinutes=480

# --- CORS: URLs do frontend separadas por virgula ---
Cors__Origins=http://localhost:5173

# --- Seed inicial (so roda com banco vazio e Seed:Enabled=true: Local/Dev) ---
Seed__StoreName=Pizzaria Demo
Seed__StoreSlug=pizzaria-demo
Seed__AdminEmail=admin@pizzaria.com
Seed__AdminPassword=TroqueEstaSenha!2026

# --- Mercado Pago (PIX + Cartao) ---
MercadoPago__AccessToken=TEST-xxxxxxxx
MercadoPago__WebhookSecret=
MercadoPago__NotificationUrl=https://SEU-DOMINIO/api/webhooks/mercadopago
MercadoPago__FallbackPayerEmail=pagamentos@seudominio.com.br
# Somente local, para testar sem assinatura (ignorado em Production):
MercadoPago__SkipSignatureValidation=true

# --- Cloudinary (fotos e videos) ---
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# --- IA do chatbot (Anthropic) ---
Anthropic__ApiKey=
Anthropic__Model=claude-haiku-5-5
